[Unit]
Description=Morning Routine: remind to log hours

[Timer]
# Default time; user times go in ~/.config/systemd/user/morgen-todo-hours.timer.d/schedule.conf
# Not Persistent: if the machine was off at 15:00, don't remind the next morning
OnCalendar=Mon..Fri 15:00

[Install]
WantedBy=timers.target
