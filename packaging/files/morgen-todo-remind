#!/bin/sh
# Kjøres av systemd-timerne: viser et varsel og åpner vinduet.
#   morgen-todo-remind morning   – morgenlisten
#   morgen-todo-remind hours     – påminnelse om timeføring
case "$1" in
  hours)
    notify-send -u critical -i no.zivid.MorgenTodo "⏱ Log your hours" "How many hours did you work today?" 2>/dev/null
    /usr/bin/morgen-todo --hours >/dev/null 2>&1 &
    ;;
  *)
    notify-send -i no.zivid.MorgenTodo "Good morning ☀️" "Time for your morning routine." 2>/dev/null
    /usr/bin/morgen-todo >/dev/null 2>&1 &
    ;;
esac
